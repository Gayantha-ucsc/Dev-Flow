+
     // ---------- Stage list rendering + editing ----------
     const listEl = document.querySelector('[data-stage-list]');
 
     function renderStages() {
         listEl.innerHTML = stages.map((s, i) => `
             <div class="stage-row" draggable="true" data-stage-id="${s.id}">
